@startuml
' workflow-arrows — the linted map of kodavr's code tree and the numbered flow.
' How to read / maintain / lint / render: AGENTS/workflow-arrows.md.
' Never edit the .svg. scripts/workflow-arrows-lint.mjs fails on any drift:
' drawers, file coverage of code dirs, links, symbols, stereotypes, step numbers.
!pragma layout smetana
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam ArrowFontSize 12
skinparam ArrowFontColor #263238
skinparam DefaultFontSize 12
skinparam nodesep 18
skinparam ranksep 28
' Stereotype themes: one per drawer; <<ext>> is reserved for external actors/systems.
skinparam component {
  BackgroundColor<<ext>> #FAFAFA
  BorderColor<<ext>> #9E9E9E
  BackgroundColor<<lib>> #E3F2FD
  BorderColor<<lib>> #1E88E5
  BackgroundColor<<cli>> #FFF3E0
  BorderColor<<cli>> #FB8C00
  BackgroundColor<<ctrl>> #E8F5E9
  BorderColor<<ctrl>> #43A047
  BackgroundColor<<view>> #EDE7F6
  BorderColor<<view>> #7E57C2
  BackgroundColor<<asset>> #FCE4EC
  BorderColor<<asset>> #D81B60
  BackgroundColor<<content>> #E0F2F1
  BorderColor<<content>> #00897B
}
left to right direction

title kodavr — drawers, bricks and the numbered flow (number · callee method · why)

' ── externals ──────────────────────────────────────────────────────────────────
actor "Author\n(opening a PR)" as AUTHOR
actor "AI agent\n(the reader)" as AGENT
actor "Human\n(a visitor)" as HUMAN
component "Ignition engine\nvendor/ignition-ssg\n--\nHandlebars SSG: input/ + data → output/public" as ENGINE <<ext>>
component "GitHub\nPages + Actions\n--\nserves the artifact, runs validate on a PR" as GH <<ext>>
component "Playwright (dev)\n--\nrasterizes the OG card and the touch icon" as PW <<ext>>

' ── drawers ────────────────────────────────────────────────────────────────────
package "scripts/lib\n====\nthe smart controller: content, machine contracts, build steps" as P_LIB {
  component "build.mjs\nbuildProject\n--\nthe one build pipeline (controller)" as BUILD <<lib>> [[../scripts/lib/build.mjs#buildProject]]
  component "dumps.mjs\nreadDumps · toDataset\n--\ncontent/dumps/* → engine datasets" as DUMPS <<lib>> [[../scripts/lib/dumps.mjs#readDumps]]
  component "markdown.mjs\nrenderMarkdown\n--\nmarkdown → sanitized HTML" as MD <<lib>> [[../scripts/lib/markdown.mjs#renderMarkdown]]
  component "pages.mjs\nbuildRouteDatasets · buildNav\n--\nroute datasets: copydeck, SEO, JSON-LD" as PAGES <<lib>> [[../scripts/lib/pages.mjs#buildRouteDatasets]]
  component "copy.mjs\n--\nsingle source of truth for every human string" as COPY <<lib>> [[../scripts/lib/copy.mjs]]
  component "i18n-en.mjs\n--\nEnglish bundle: copydeck keys, values referenced verbatim" as I18N_EN <<lib>> [[../scripts/lib/i18n-en.mjs]]
  component "i18n-ru.mjs\n--\nRussian bundle: a draft translation of every copydeck key" as I18N_RU <<lib>> [[../scripts/lib/i18n-ru.mjs]]
  component "i18n-zh-Hans.mjs\n--\nSimplified Chinese bundle: a draft translation of every copydeck key" as I18N_ZH <<lib>> [[../scripts/lib/i18n-zh-Hans.mjs]]
  component "i18n-es.mjs\n--\nSpanish bundle: a draft translation of every copydeck key" as I18N_ES <<lib>> [[../scripts/lib/i18n-es.mjs]]
  component "i18n.mjs\nLOCALES · t · assertComplete\n--\nthe locale registry and the loud keyed translator" as I18N <<lib>> [[../scripts/lib/i18n.mjs#t]]
  component "jsonld.mjs\nserializeJsonLd\n--\nsafe schema.org @graph per page" as JSONLD <<lib>> [[../scripts/lib/jsonld.mjs#serializeJsonLd]]
  component "machine.mjs\nwriteMachineFiles · writeSitemap\n--\nindex.json, schemas, well-known, feeds, tags, sitemap" as MACHINE <<lib>> [[../scripts/lib/machine.mjs#writeMachineFiles]]
  component "schema.mjs\nbuildIndexSchema · buildManifestSchema\n--\nself-describing JSON Schemas for index/manifest" as SCHEMA <<lib>> [[../scripts/lib/schema.mjs#buildIndexSchema]]
  component "ignition.mjs\nrunIgnition\n--\nspawns the vendored engine" as IGN <<lib>> [[../scripts/lib/ignition.mjs#runIgnition]]
  component "relativize.mjs\nrelativizeSite\n--\nhost-agnostic internal links" as REL <<lib>> [[../scripts/lib/relativize.mjs#relativizeSite]]
  component "verbatim.mjs\nROBOTS_TXT · HUMANS_TXT\n--\nverbatim robots/humans" as VERB <<lib>> [[../scripts/lib/verbatim.mjs]]
  component "static-server.mjs\ncreateStaticServer\n--\nlocal preview server" as SSRV <<lib>> [[../scripts/lib/static-server.mjs#createStaticServer]]
  component "manifest-card.mjs\nrenderManifestCard\n--\nmanifest.json → the PR reviewer's card" as MCARD <<lib>> [[../scripts/lib/manifest-card.mjs#renderManifestCard]]
  component "telegram-mirror.mjs\nrenderMirrorPost\n--\nmanifest + brief → a Telegram mirror post" as TGMIRROR <<lib>> [[../scripts/lib/telegram-mirror.mjs#renderMirrorPost]]
  component "audit-channel.mjs\nmakeSpan · validateChannelResult\n--\nchannel output schema + allowlist validator" as AUDIT_CH <<lib>> [[../scripts/lib/audit-channel.mjs#validateChannelResult]]
  component "audit-detectors.mjs\nstructuralChannel\n--\nLayer-1 structural detectors (invisible, base64, homoglyph, hidden)" as AUDIT_DET <<lib>> [[../scripts/lib/audit-detectors.mjs#structuralChannel]]
  component "audit-forensic.mjs\nbuildForensicMap\n--\nconverged top-N span map for the human" as AUDIT_FOR <<lib>> [[../scripts/lib/audit-forensic.mjs#buildForensicMap]]
  component "audit-policy.mjs\nevaluatePolicy\n--\ndeterministic envelope + channels -> decision" as AUDIT_POL <<lib>> [[../scripts/lib/audit-policy.mjs#evaluatePolicy]]
  component "audit-envelope.mjs\ncheckDiffShape · evaluateEnvelope\n--\nLayer-0 envelope: diff shape + author signals (no content text)" as AUDIT_ENV <<lib>> [[../scripts/lib/audit-envelope.mjs#evaluateEnvelope]]
  component "audit-report.mjs\nrenderAuditComment\n--\nadvisory PR comment: forensic map, no scores, escaped" as AUDIT_REP <<lib>> [[../scripts/lib/audit-report.mjs#renderAuditComment]]
  component "audit-pr.mjs\nrunAudit\n--\nPR audit orchestration: API inputs -> envelope + policy (shadow)" as AUDIT_PR <<lib>> [[../scripts/lib/audit-pr.mjs#runAudit]]
  component "audit-local.mjs\ndumpToPr · auditDumps\n--\nlocal harness: our own dumps -> the pipeline's verdicts" as AUDIT_LOCAL <<lib>> [[../scripts/lib/audit-local.mjs#dumpToPr]]
  component "audit-llm.mjs\nproviderFromAuth · callAuditLLM\n--\nthe LLM provider client: credentials + one strict-JSON call" as AUDIT_LLM <<lib>> [[../scripts/lib/audit-llm.mjs#callAuditLLM]]
  component "audit-judge.mjs\nframeContent · judgeChannel\n--\nLayer-4 LLM judge: data frame, allowlist schema, ensemble" as AUDIT_JUDGE <<lib>> [[../scripts/lib/audit-judge.mjs#judgeChannel]]
  component "audit-trace.mjs\ndetectTraceResidue · quoteMask\n--\nLayer-5 deterministic residue classifier + non-LLM quote-masker" as AUDIT_TRACE <<lib>> [[../scripts/lib/audit-trace.mjs#detectTraceResidue]]
  component "audit-meta.mjs\nbuildMetaMessages · metaReviewChannel\n--\nLayer-5 LLM meta-reviewer over a quote-masked trace (witness channel)" as AUDIT_META <<lib>> [[../scripts/lib/audit-meta.mjs#metaReviewChannel]]
