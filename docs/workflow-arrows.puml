package "input/controllers\n====\nclient controllers injected by the engine" as P_CTRL {
  component "dumps.js\n--\nthe gate, the hall, the reception toggle" as CTRL_DUMPS <<ctrl>> [[../input/controllers/dumps.js]]
  component "reception.js\n--\nthe reception page behaviour" as CTRL_REC <<ctrl>> [[../input/controllers/reception.js]]
}

package "input/templates\n====\nHandlebars layouts + partials (the HTML projection)" as P_VIEW {
  component "home.hbs · about.hbs · dumps.hbs\nreception.hbs · contribute.hbs\n--\nthe human-surface layouts" as VIEW_PAGES <<view>> [[../input/templates/home.hbs]]
  component "site/gate.hbs · site/reception-block.hbs\n--\nthe consumption-contract partials" as VIEW_GATE <<view>> [[../input/templates/site/gate.hbs]]
}

package "static/assets\n====\nstylesheet, client JS and brand assets" as P_ASSET {
  component "styles.css · site.js\n--\nstyling + the copy-button behaviour" as ASSET <<asset>> [[../static/assets/styles.css]]
  component "logo.svg · og-default.png\ntouch-icon-192.png\n--\nthe wordmark and social/touch images" as ASSET_IMG <<asset>> [[../static/logo.svg]]
}

package "content/dumps\n====\nthe dumps themselves: manifest.json + raw.md per slug" as P_CONTENT {
  component "2026-09-14-kodavr-manifesto/\nmanifest.json + raw.md\n--\nthe launch dump: demo + platform manifesto" as DUMP1 <<content>> [[../content/dumps/2026-09-14-kodavr-manifesto/manifest.json]]
}

' ── flow ───────────────────────────────────────────────────────────────────────
' The publish pipeline: one controller, two entry points (local + CI).
CLI_BUILD -[#FB8C00]-> BUILD : [[../scripts/lib/build.mjs#buildProject 1 · buildProject()]]\nthe CLI hands off to the one pipeline
BUILD -[#1E88E5]-> DUMPS : [[../scripts/lib/dumps.mjs#readDumps 2 · readDumps()]]\nread every content/dumps/*
BUILD -[#1E88E5]-> DUMPS : [[../scripts/lib/dumps.mjs#toDataset 3 · toDataset()]]\nmerge the manifest, turn the body into HTML
DUMPS -[#1E88E5]-> MD : [[../scripts/lib/markdown.mjs#renderMarkdown 4 · renderMarkdown()]]\nsanitize before markdown becomes HTML
BUILD -[#1E88E5]-> PAGES : [[../scripts/lib/pages.mjs#buildRouteDatasets 5 · buildRouteDatasets()]]\nassemble every route's dataset
PAGES -[#1E88E5]-> COPY : [[../scripts/lib/copy.mjs 6 · copydeck slices]]\ntemplates never retype contract text
PAGES -[#1E88E5]-> JSONLD : [[../scripts/lib/jsonld.mjs#serializeJsonLd 7 · serializeJsonLd()]]\nper-page schema.org @graph
BUILD -[#1E88E5]-> IGN : [[../scripts/lib/ignition.mjs#runIgnition 8 · runIgnition()]]\nhand input/ + data to the engine
IGN -[#9E9E9E]-> ENGINE : 9 · engine build\nthe SSG renders output/public
BUILD -[#1E88E5]-> REL : [[../scripts/lib/relativize.mjs#relativizeSite 10 · relativizeSite()]]\nrewrite internal links per page depth
BUILD -[#1E88E5]-> MACHINE : [[../scripts/lib/machine.mjs#writeMachineFiles 11 · writeMachineFiles()]]\nindex.json, well-known, feeds, tags
BUILD -[#1E88E5]-> MACHINE : [[../scripts/lib/machine.mjs#writeSitemap 12 · writeSitemap()]]\nsitemap.xml over the pretty URLs
MACHINE ..> GH : 13 ⟵ output/public\nthe artifact GitHub Pages serves

' The consumption loop: machines first, humans at the reception.
AGENT -[#43A047]-> MACHINE : [[../scripts/lib/machine.mjs 14 · GET /index.json]]\nthe agent picks dumps by field
AGENT -[#43A047]-> DUMP1 : [[../content/dumps/2026-09-14-kodavr-manifesto/manifest.json 15 · GET manifest.json + raw]]\nfetch the contract and the body
HUMAN -[#43A047]-> CTRL_DUMPS : [[../input/controllers/dumps.js 16 · gate → reception]]\ncheck in, or hand the dump to an agent
AUTHOR -[#00897B]-> CLI_VAL : [[../scripts/validate.mjs#validateContent 17 · PR → validate]]\nevery dump arrives as a validated PR

' Structural edges (dashed, unnumbered): imports, assets and dev tools —
' the glue that anchors every brick to the flow.
BUILD ..> ASSET : publishes static/ into the artifact
BUILD ..> ASSET_IMG : and the brand images
IGN ..> VIEW_PAGES : the engine renders the layouts
IGN ..> VIEW_GATE : and the consumption-contract partials
IGN ..> CTRL_DUMPS : injects the page controller
IGN ..> CTRL_REC : injects the reception controller
PAGES ..> MACHINE : reads buildIndexEntry / buildWellKnown
MACHINE ..> SCHEMA : embeds + serves the index/manifest JSON Schemas
MACHINE ..> VERB : writes robots.txt / humans.txt verbatim
CLI_SERVE ..> SSRV : serves output/public locally
CLI_OG ..> PW : rasterizes the OG card
CLI_TI ..> PW : rasterizes the touch icon
GH ..> CLI_REQ : runs the coverage check
GH ..> CLI_LINT : guards this map
GH ..> CLI_CONTRACT : guards the module index
GH ..> CLI_CARD : runs the manifest card on a PR\nso the reviewer sees the fields
GH ..> CLI_TGMIRROR : runs the dump mirror after a successful deploy
GH ..> CLI_AUDIT : runs the PR audit in shadow mode\nadvisory comment + status, no merge
CLI_AUDIT_LOCAL ..> AUDIT_LOCAL : reads content/dumps/* locally\nand prints what the pipeline says
CLI_AUDIT_JUDGE ..> AUDIT_JUDGE : frames our own dumps as data\nand runs the Layer-4 judge locally
CLI_AUDIT_JUDGE ..> AUDIT_LLM : resolves the provider from env, auth or a work-flow config\n(never a hardcoded key)
AUDIT_JUDGE ..> AUDIT_LLM : one strict-JSON chat call per judge run
AUDIT_JUDGE ..> AUDIT_CH : normalizes the judge verdict into a channel result
CLI_AUDIT ..> AUDIT_PR : fetches the diff + author signals via the API\nand runs the deterministic audit
CLI_AUDIT ..> AUDIT_LLM_CH : builds the LLM channels from env\nand passes them to the pure audit
AUDIT_LLM_CH ..> AUDIT_LLM : resolves the provider from env\nand retries transient errors
AUDIT_LLM_CH ..> AUDIT_JUDGE : runs the judge, plus a second run for the ensemble
AUDIT_LLM_CH ..> AUDIT_TRACE : reads the primary run's reasoning trace deterministically
AUDIT_LLM_CH ..> AUDIT_META : and asks the meta-reviewer over the masked trace
AUDIT_PR ..> AUDIT_ENV : builds the Layer-0 envelope from the diff shape
AUDIT_PR ..> AUDIT_DET : scans the API patch with the Layer-1 detectors
AUDIT_PR ..> AUDIT_POL : reduces envelope + channels to a recommendation
AUDIT_PR ..> AUDIT_REP : renders the advisory comment (marker, no scores)
CLI_CARD ..> MCARD : renders content/dumps/<slug>/manifest.json
AGENT ..> CLI_DIET : keeps STATE.md compact

legend right
  **how to read an arrow**
  line 1 (colored link):  N · callee.method()  — the API method
  of the TARGET brick this arrow calls (the callee), N = order 1 to 17
  line 2 (plain text):    why the call happens (business intent)
  solid = call · dashed = return · dashed to an actor = a push
  click a brick → its file · click a call → the method's source
  **drawers** = first-party code dirs; the code drawers are covered
  file-by-file (scripts/lib, scripts, input/controllers)
  **linted idioms** (workflow-arrows-lint): a brick's stereotype =
  its drawer; every numbered call links the callee method,
  returns carry no link; step numbers are exactly 1..N
endlegend

@enduml
