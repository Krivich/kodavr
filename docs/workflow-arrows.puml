package "scripts\n====\nentry points you actually run" as P_CLI {
  component "build.mjs\n--\nnpm run build → output/public" as CLI_BUILD <<cli>> [[../scripts/build.mjs]]
  component "validate.mjs\nvalidateContent · validateManifest\n--\nKDV-CI gate over content/dumps" as CLI_VAL <<cli>> [[../scripts/validate.mjs#validateContent]]
  component "req-coverage.js\n--\nreconcile tests ↔ REQUIREMENTS.md" as CLI_REQ <<cli>> [[../scripts/req-coverage.js]]
  component "serve.mjs\n--\nlocal static server" as CLI_SERVE <<cli>> [[../scripts/serve.mjs]]
  component "state-diet.mjs\n--\nSTATE.md chronicle → docs/history" as CLI_DIET <<cli>> [[../scripts/state-diet.mjs]]
  component "generate-og-image.mjs\n--\nrasterizes the OG card" as CLI_OG <<cli>> [[../scripts/generate-og-image.mjs]]
  component "generate-touch-icon.mjs\n--\nrasterizes the touch icon" as CLI_TI <<cli>> [[../scripts/generate-touch-icon.mjs]]
  component "workflow-arrows-lint.mjs\nlintDiagram\n--\nthis map's drift alarm" as CLI_LINT <<cli>> [[../scripts/workflow-arrows-lint.mjs#lintDiagram]]
  component "contract.mjs\nvalidateAll\n--\nguards the module index (contract headers)" as CLI_CONTRACT <<cli>> [[../scripts/contract.mjs#validateAll]]
  component "pr-manifest-card.mjs\n--\nposts the sticky manifest card on a PR" as CLI_CARD <<cli>> [[../scripts/pr-manifest-card.mjs]]
  component "telegram-mirror.mjs\n--\nmirrors newly published dumps to Telegram" as CLI_TGMIRROR <<cli>> [[../scripts/telegram-mirror.mjs]]
  component "audit-pr.mjs\n--\nposts the advisory PR audit comment and status" as CLI_AUDIT <<cli>> [[../scripts/audit-pr.mjs]]
  component "audit-local.mjs\n--\nruns the audit pipeline over our own dumps (npm run audit:local)" as CLI_AUDIT_LOCAL <<cli>> [[../scripts/audit-local.mjs]]
  component "audit-judge-local.mjs\n--\nruns the Layer-4 judge over our own dumps (npm run audit:judge)" as CLI_AUDIT_JUDGE <<cli>> [[../scripts/audit-judge-local.mjs]]
