{{!-- ignition: noblock --}}
<!DOCTYPE html>
<html lang="{{lang}}"{{#if rtl}} dir="rtl"{{/if}}>
<head>
{{> site/head}}
</head>
<body>
<a class="skip-link" href="#main">{{copy.skip_to_content}}</a>
<div class="sheet">
{{> site/header}}
<main id="main" tabindex="-1" class="home sheet-inner">
  {{!-- §6.1 v4/KDV-SURFACE-24: the storefront hero is the literal brand wordmark
       `KODAVR` over the positioning sentence as a lead, with the home_explainer
       paragraph (feedback-marketing item 3, owner copy 2026-09-24) selling the
       reader-benefit value prop: a registry of raw experience — code, workflows,
       field reports — your AI agent adapts to your task, stack and style. The
       term `a dump` is emphasized from its own catalog part; the plain
       HOME_TITLE stays the SEO <title>/JSON-LD string. The hero plate carries NO
       `data-plate` label, so no `::before` number sits above the storefront. --}}
  <section class="plate">
    <h1 class="home-wordmark">KODAVR</h1>
    <p class="home-lead">{{home_title.lead}}<strong>{{home_title.term}}</strong>{{home_title.tail}}</p>
    <p>{{copy.home_explainer}}</p>
    {{!-- §6.1 v4/KDV-SURFACE-24: two doors from the hero — understand it, or publish. --}}
    <p class="cta-row"><a class="cta" href="{{locale_prefix}}/about/">{{copy.home_about_cta}}</a> <a class="cta" href="{{locale_prefix}}/contribute/">{{copy.home_contribute_cta}}</a></p>
  </section>

  {{!-- §6.1 v4/KDV-SURFACE-27: the human on-ramp — the universal §7.4 prompt and
       the §7.12 agent lane, above the feed so the ritual comes before the index.
       The prompt id (`home-prompt`) is the copy control's target. --}}
  <section class="plate" data-plate="{{copy.home_plate_humans}}">
    <h2>{{copy.home_humans_heading}}</h2>
{{> site/agent-lane copyTarget="home-prompt"}}
    <pre class="home-prompt" id="home-prompt">{{copy.prompt}}</pre>
  </section>

  <section class="plate" data-plate="{{copy.home_plate_latest}}">
    <h2>{{copy.home_latest_lead}}<em>{{copy.home_latest_term}}</em></h2>
    <section class="dump-feed">
      {{> ignition/pagination
          collection="dumps"
          perPage=10
          pageTemplate="home/page"
          layout=layout
          dataset=dataset
      }}
    </section>
  </section>

  <section class="plate" data-plate="{{copy.home_plate_machines}}">
    <h2>{{copy.home_for_machines}}</h2>
    <pre class="block-machine">curl -s {{index_url}}</pre>
    <ul class="linklist">
      <li><a href="/index.json">/index.json</a></li>
      <li><a href="/.well-known/kodavr.json">/.well-known/kodavr.json</a></li>
      <li><a href="/feeds/all.atom">/feeds/all.atom</a></li>
    </ul>
  </section>

  {{!-- §2.2/§6.1: the trust-level legend — a lead plus a definition list whose
       tokens are the same monospace badges as the manifest metadata, and whose
       meanings are prose. One source: machine.mjs via the route dataset. --}}
  <section class="plate" data-plate="{{copy.home_plate_trust}}">
    <h2>{{copy.home_trust_levels}}</h2>
    <p class="trust-legend-lead">{{trust_legend.lead}}</p>
    <dl class="trust-legend">
      {{#each trust_legend.levels}}
      <div><dt>{{this.level}}</dt><dd>{{this.meaning}}</dd></div>
      {{/each}}
    </dl>
  </section>
</main>
{{> site/footer}}
</div>
</body>
</html>
