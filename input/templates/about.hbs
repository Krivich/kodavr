{{!-- ignition: noblock --}}
<!DOCTYPE html>
<html lang="{{lang}}"{{#if rtl}} dir="rtl"{{/if}}>
<head>
{{> site/head}}
</head>
<body>
<a class="skip-link" href="#main">{{copy.skip_to_content}}</a>
<div class="sheet">
{{> site/header}}
<main id="main" tabindex="-1" class="about sheet-inner">
  <section class="plate" data-plate="{{copy.about_plate_manifesto}}">
    <p class="kicker">{{copy.about_kicker}}</p>
    <h1>{{title}}</h1>
    <p class="lead">{{copy.about_lead}}</p>
    <blockquote class="block-statement">
      <p>{{what_is_a_dump.definition}} {{what_is_a_dump.lead}} <span class="dump-prompt">"{{what_is_a_dump.prompt}}"</span> {{what_is_a_dump.tail}}</p>
    </blockquote>
    <blockquote class="block-statement emph">
      <p>{{copy.about_no_fear}}</p>
    </blockquote>
  </section>

  <section class="plate" data-plate="{{copy.about_plate_authors}}">
    <h2>{{copy.about_for_authors_heading}}</h2>
    <p>{{copy.about_for_authors_lead}}</p>
    <div class="prose">
      <ul>
        <li><strong>{{copy.about_authors_raw_title}}</strong> {{copy.about_authors_raw_body}}</li>
        <li><strong>{{copy.about_authors_pr_title}}</strong> {{copy.about_authors_pr_body}}</li>
        <li><strong>{{copy.about_authors_field_title}}</strong> {{copy.about_authors_field_body}}</li>
        <li><strong>{{copy.about_authors_attribution_title}}</strong> {{copy.about_authors_attribution_body}}</li>
      </ul>
    </div>
  </section>

  <section class="plate" data-plate="{{copy.about_plate_readers}}">
    <h2>{{copy.about_for_readers_heading}}</h2>
    <p>{{copy.about_for_readers_lead}}</p>
    <div class="prose">
      <ul>
        <li><strong>{{copy.about_readers_adaptation_title}}</strong> {{copy.about_readers_adaptation_body}}</li>
        <li><strong>{{copy.about_readers_synthesis_title}}</strong> {{copy.about_readers_synthesis_body}}</li>
        <li><strong>{{copy.about_readers_trust_title}}</strong> {{copy.about_readers_trust_body}}</li>
        <li><strong>{{copy.about_readers_stream_title}}</strong> {{copy.about_readers_stream_body}}</li>
      </ul>
    </div>
  </section>

  <section class="plate" data-plate="{{copy.about_plate_mechanism}}">
    <h2>{{copy.about_mechanism_heading}}</h2>
    <ol class="steps">
      <li>{{copy.about_mechanism_step1}}</li>
      <li>{{copy.about_mechanism_step2}}</li>
      <li>{{copy.about_mechanism_step3}}</li>
    </ol>
  </section>

  <section class="plate" data-plate="{{copy.about_plate_architecture}}">
    <h2>{{copy.about_arch_heading}}</h2>
    <div class="prose">
      <ul>
        <li><strong>{{copy.about_arch_raw_title}}</strong> {{copy.about_arch_raw_body}}</li>
        <li><strong>{{copy.about_arch_contract_title}}</strong> {{copy.about_arch_contract_body_lead}} <code>/.well-known/kodavr.json</code>{{copy.about_arch_contract_body_tail}}</li>
        <li><strong>{{copy.about_arch_cheap_title}}</strong> {{copy.about_arch_cheap_body}}</li>
        <li><strong>{{copy.about_arch_safety_title}}</strong> {{copy.about_arch_safety_body}}</li>
        <li><strong>{{copy.about_arch_trust_title}}</strong> {{copy.about_arch_trust_body}}</li>
      </ul>
    </div>
    <p class="micro"><a href="/docs/decisions.md">{{copy.about_decisions_label}} — docs/decisions.md</a></p>
  </section>

  <section class="plate" data-plate="{{copy.about_plate_colophon}}">
    <div class="mark-lg"><img src="/logo.svg" alt="Kodavr" width="64" height="64"></div>
    <p class="slogan">{{copy.brand_slogan_lead}}</p>
    <p class="slogan-muted">{{copy.brand_slogans_muted}}</p>
  </section>
</main>
{{> site/footer}}
</div>
</body>
</html>
