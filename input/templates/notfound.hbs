{{!-- ignition: noblock --}}
<!DOCTYPE html>
<html lang="{{lang}}"{{#if rtl}} dir="rtl"{{/if}}>
<head>
{{> site/head}}
</head>
<body>
<a class="skip-link" href="#main">{{copy.skip_to_content}}</a>
<div class="sheet">
{{> site/header}}
<main id="main" tabindex="-1" class="not-found sheet-inner void">
  <section class="plate" data-plate="{{copy.notfound_plate_void}}">
    <p class="kicker">{{copy.not_found_kicker}}</p>
    {{!-- §6.6: the visible §7.6 block is a <pre>; this sr-only H1 still gives the
         page exactly one heading for assistive tech without changing the copy. --}}
    <h1 class="sr-only">{{title}}</h1>
    <pre class="not-found-text">{{copy.notFound}}</pre>
    <p class="gate-hint">{{copy.not_found_note}}</p>
    <p><a class="cta" href="{{locale_prefix}}/">{{copy.not_found_cta}}</a></p>
  </section>
</main>
{{> site/footer}}
</div>
</body>
</html>
