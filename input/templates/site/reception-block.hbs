{{!-- Call at column 0 — see the note in site/gate.hbs.
     On a dump page the block starts hidden in SSR (button "1" reveals it); the
     /reception/ page passes reveal=true, where reception IS the page content. --}}
<section class="reception-block card"{{#unless reveal}} hidden{{/unless}} aria-labelledby="reception-title">
  <h2 id="reception-title" class="sr-only">{{copy.reception_title}}</h2>
{{> site/agent-lane copyTarget="reception-prompt"}}
  <pre class="reception-prompt" id="reception-prompt">{{copy.prompt}}</pre>
  <pre class="reception-text">{{copy.reception_wall}}</pre>
  {{!-- §6.3/§7.2 v2: the third tier — the author's agent brief for a human
       stranger. The optional summary.md layer arrives as `brief_html` (rendered
       HTML, already sanitized). Without it two variants: a dump page shows the
       honest fallback (a manifest card really follows), while standalone
       /reception/ — where no dump sits — shows `brief_note_platform` instead,
       never the dump-oriented fallback. --}}
  <div class="reception-brief-section">
    <h3 class="reception-brief-heading">{{copy.brief_heading}}</h3>
    <p class="reception-brief-note">{{#if copy.brief_note_platform}}{{copy.brief_note_platform}}{{else}}{{copy.brief_note}}{{/if}}</p>
    {{#if brief_html}}<div class="reception-brief">{{{brief_html}}}</div>{{else}}{{#unless copy.brief_note_platform}}<div class="reception-brief"><p class="reception-brief-missing">{{copy.brief_fallback}}</p></div>{{/unless}}{{/if}}
    <p class="reception-brief-cta">{{copy.brief_cta}}</p>
  </div>
  {{!-- §6.5 v2: the legal tail is the demo `.legal-group` — the report line
       and the 18+ rating together under one hairline. --}}
  <div class="legal-group">
    <p class="reception-brief-report">{{copy.brief_report}}</p>
    <p class="reception-rating">{{copy.reception_rating}}</p>
  </div>
{{#unless reveal}}
  <p class="reset-link-wrap resetline"><a href="/" class="reset-link" data-reset-machine>{{copy.reset_label}}</a></p>
{{/unless}}
</section>
