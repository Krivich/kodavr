{{!-- ignition: noblock --}}
<!DOCTYPE html>
<html lang="{{lang}}"{{#if rtl}} dir="rtl"{{/if}}>
<head>
{{> site/head}}
</head>
<body>
<a class="skip-link" href="#main">{{copy.skip_to_content}}</a>
<div class="sheet">
{{> site/header}}
<main id="main" tabindex="-1" class="reception-page sheet-inner">
  <section class="plate" data-plate="{{copy.reception_plate_checkin}}">
    <p class="kicker">{{copy.reception_kicker}}</p>
    <h1>{{title}}</h1>
    <p class="lead">{{copy.reception_lead}}</p>
{{> site/reception-block reveal=true}}
    <p id="a11y-status" class="sr-only" role="status" aria-live="polite"></p>
    <p class="reset-link-wrap resetline"><a href="{{locale_prefix}}/" class="reset-link" data-reset-machine>{{copy.reset_label}}</a></p>
  </section>
</main>
{{> site/footer}}
</div>
</body>
</html>
