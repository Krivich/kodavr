{{!-- ignition: noblock --}}
<!DOCTYPE html>
<html lang="{{lang}}"{{#if rtl}} dir="rtl"{{/if}}>
<head>
{{> site/head}}
</head>
<body>
<a class="skip-link" href="#main">{{copy.skip_to_content}}</a>
<div class="sheet">
{{> site/header}}
<main id="main" tabindex="-1" class="contribute sheet-inner">
  <section class="plate" data-plate="{{copy.contribute_plate_authors}}">
    <p class="kicker">{{copy.contribute_kicker}}</p>
    <h1>{{title}}</h1>
    <p class="lead">{{copy.contribute_lead}}</p>
    <p>{{copy.contribute_lead_2}}</p>
    <p>{{copy.contribute_lead_3}}</p>
  </section>
  <section class="plate" data-plate="{{copy.contribute_plate_flow}}">
    {{!-- feedback-contribute_skill item 01: the contribute-lane leads the plate —
         ONE copy control over the §7.16 prompt, no chat links (publishing is a
         coding agent's job, §7.12's contribute variant); the manual path follows
         under its own heading (item 03). The button wires the copydeck's copied
         label/announcement exactly like site/agent-lane.hbs. --}}
    <div class="contribute-lane">
      <p class="agent-lane-lead">{{copy.contribute_lane_lead}}</p>
      <p><button type="button" class="copy-prompt contribute-copy" data-copy-target="contribute-prompt" data-copied-label="{{copy.copied_label}}" data-copied-announcement="{{copy.copied_announcement}}">{{copy.contribute_lane_button}}</button></p>
      <pre class="contribute-prompt" id="contribute-prompt">{{copy.contribute_prompt}}</pre>
      <p class="agent-lane-hint">{{copy.contribute_lane_hint}}</p>
      <p class="contribute-lane-secondary"><a href="{{locale_prefix}}/dumps/2026-09-18-kodavr-dump-skill/">{{copy.contribute_lane_secondary}}</a></p>
    </div>
    <h2>{{copy.contribute_bring_heading}}</h2>
    <ol class="steps">
      <li>{{copy.contribute_step_fork_lead}} <code>content/dumps/&lt;slug&gt;/manifest.json</code> {{copy.contribute_step_fork_and}} <code>raw.md</code>.</li>
      <li>{{copy.contribute_step_pr}}</li>
      <li>{{copy.contribute_step_ci}}</li>
    </ol>
  </section>
  <section class="plate" data-plate="{{copy.contribute_plate_schema}}">
    <h2>{{copy.contribute_schema_heading}}</h2>
    <p>{{copy.contribute_schema_required}}</p>
    <pre class="block-machine">{
  "slug":    "YYYY-MM-DD-short-name",
  "title":   "string",
  "type":    "note | case | pack",
  "domain":  "engineering | finance | art | law | science | education | other",
  "date":    "YYYY-MM-DD",
  "stakes":  "low | medium | high",
  "trust_level": "raw | self-tested | community-tested | adapted | library",
  "content_flags": [],
  "summary": "1–3 sentences"
}</pre>
    <ul class="checklist">
      <li>{{copy.contribute_check_secrets}}</li>
      <li>{{copy.contribute_check_examples}}</li>
      <li>{{copy.contribute_check_redactions_lead}} REDACTIONS.md {{copy.contribute_check_redactions_tail}}</li>
      <li>{{copy.contribute_check_stakes}}</li>
      <li>{{copy.contribute_check_generated_by}}</li>
      <li>{{copy.contribute_check_heavy}}</li>
    </ul>
  </section>
  <section class="plate" data-plate="{{copy.contribute_plate_licences}}">
    <h2>{{copy.contribute_licences_heading}}</h2>
    <p>{{copy.contribute_licences_lead}}</p>
    <p class="micro"><a href="https://github.com/krivich/kodavr/blob/main/CONTRIBUTING.md">{{copy.contribute_house_rules_label}} — CONTRIBUTING.md</a> · <a href="https://github.com/krivich/kodavr/issues">{{copy.contribute_issues_label}}</a></p>
  </section>
</main>
{{> site/footer}}
</div>
</body>
</html>
